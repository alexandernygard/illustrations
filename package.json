{
  "name": "site-cover",
  "version": "0.1.0",
  "description": "Cohesive, artistic cover images (og:image) for Alex's projects, driven by a small JSON spec.",
  "type": "module",
  "private": true,
  "bin": {
    "site-cover": "src/cli.ts"
  },
  "scripts": {
    "gallery": "bun src/cli.ts gallery -o gallery",
    "check": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./render": "./src/render.ts"
  },
  "files": [
    "src",
    "fonts",
    "skill"
  ]
}
